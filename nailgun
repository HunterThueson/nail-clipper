#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Quick script to rapidly generate a bunch of thumbnails (like a machine gun, 
# hence the name) from a given video to ~/.temp/ (by default) or a given directory
#

#############################
#  Set/unset shell options  #
#############################

if [[ ! "${BASHOPTS}" =~ "extglob" ]]; then
    shopt -s extglob
    EXTGLOB=0
else
    EXTGLOB=1
fi

###########################
#  Variable declarations  #
###########################

# generate a thumbnail every $frameskip frames
declare -i frameskip
frameskip=300

prefix=""                                        # string to append at beginning of file names
output_dir="${PWD}/thumbnails/"                  # thumbnail output directory

start_time=""                                    # timecode at which to start thumbnail generation
end_time=""                                      # timecode at which to end thumbnail generation

###########################
#  Function declarations  #
###########################

# unset extglob if it wasn't set before running command
# NOTE: must be passed one argument to use as exit code

cleanup () {
    if [[ $EXTGLOB = 0 ]]; then
        shopt -u extglob
        exit $1
    else
        exit $1
    fi
};

# Help function
# NOTE: must be passed one argument to use as exit code
help_message () {
    printf '''
nailgun: a tool for rapidly generating thumbnails from a video file

Usage: nailgun [OPTIONS] input_file

Options:
    -h |     | --help           Display this help message and exit
    -s | -ss | --start          Begin generating thumbnails from this point in the video
                                (see "Timecodes" section below)
    -e | -to | --end            Stop generating thumbnails after this point in the video
                                (see "Timecodes")
  ! -p |     | --prefix         Set prefix to append to the beginning of filenames
                                (default: none)
    -d |     | --output-dir     Set the destination directory for generated thumbnails
                                (default: $PWD/thumbnails)
    -f |     | --frameskip      Set the number of frames between each generated thumbnail
                                (default: 300)

  Options marked with a leading "!" are accepted but not yet implemented.

Timecodes:
  Timecodes can be formatted in any way `ffmpeg` accepts. This includes:

  00:12             12 seconds into the video; "minutes" section must be included in this case
  12:34             minute 12 + 34 seconds
  12:34.567         numbers after decimal point refer to the timestamp of an exact frame
  00:12:34          minute 12 + 34 seconds; the "hours" section is included but not needed
  00:12:34.567      hours section included, exact frame specified

  See `ffmpeg` documentation for more details.
    '''
    cleanup $1
}

fatal () {
    printf "$0: fatal: $*\n" >&2
    help_message 1
}

# give the user one more chance to enter a valid answer
# takes one argument: the number of retries already given
bad_answer () {
    [[ $1 > 0 ]] && fatal could not understand user input
    printf "\nI couldn't understand your answer. Please enter yes or no: "
    read answer
    if [[ ! $answer = "" ]]; then
        return $answer
    else
        fatal could not understand user input
    fi
};

join_array () {
  local IFS="$1"
  shift
  echo "$*"
};

#####################
#  Check arguments  #
#####################

[[ $# < 1 ]] && fatal 'not enough arguments'

while [[ $1 != "" ]]; do
    case $1 in
        "-h"|"--help") help_message 0;;
        "-f"|"--frameskip") frameskip=$2; shift 2;;
        "-p"|"--prefix") prefix=$2; shift 2;;
        "-d"|"--output-dir") output_dir=${2%/}; shift 2;;
        "-s"|"-ss"|"--start") start_time="$2"; shift 2;;
        "-e"|"-to"|"--end") end_time="$2"; shift 2;;
        (*) break;;
    esac
done

# TODO: Test that non-option arguments are files that exist and are *.mp4
# TODO: Add option `-p` | `--prefix_with_file`, which sets $prefix to filename
# TODO: Test that variable following '-f' is an int

intermediate_filename=${1##*/}
filename=${intermediate_filename%%.*}

retries=0

##########################################
#  Create output directory if necessary  #
##########################################

if [[ ! -d $output_dir ]]; then
    printf "Output directory $output_dir does not exist.\n"
    printf "Do you want to create it? (y/N): "; read answer
    while [[ ! $answer = "" ]]; do
        case $answer in
            ("y"|"Y"|"yes"|"YES") mkdir $output_dir && \
                printf "\nCreated output directory: $output_dir\n"; break;;
            ("n"|"N"|"no"|"NO") printf "Aborting...\n"; cleanup 1;;
            (*) bad_answer $retries; answer=$?; retries=1;;
        esac
    done
fi

################
# Set options #
###############

declare -i counter;

pre_options=()
vf_options=()
post_options=()

vf_options[${counter}]="select='not(mod(n,${frameskip}))'"
counter=$((${counter} + 1 ))

vf_options[$counter]="scale=1024:1024:force_original_aspect_ratio=decrease"

counter=0

if [[ ! ${start_time} = "" ]]; then
    pre_options[${counter}]="-ss ${start_time}"
    counter=$((${counter} + 1 ))
fi

if [[ ! ${end_time} = "" ]]; then
    post_options[${counter}]="-to ${end_time}"
    counter=$((${counter} + 1 ))
fi

post_options[${counter}]="-f image2"

#########################
#  Generate thumbnails  #
#########################

ffmpeg -hide_banner ${pre_options[@]} -i $1 -vf "$(join_array , "${vf_options[@]}")" ${post_options[@]} $output_dir/$prefix_$filename-%04d.png

#####################
#  Exit gracefully  #
#####################

cleanup 0

